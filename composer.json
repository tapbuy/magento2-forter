{
    "name": "tapbuy/magento2-forter",
    "description": "Tapbuy Forter Integration for Magento 2",
    "type": "magento2-module",
    "version": "1.3.0",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "php": "^8.1"
        "magento/framework": "^103.0",
        "magento/module-customer": "^103.0",
        "magento/module-sales": "^103.0",
        "magento/module-quote-graph-ql": "^100.4",
        "tapbuy/redirect-tracking": "^1.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Tapbuy\\Forter\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tapbuy\\Forter\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}